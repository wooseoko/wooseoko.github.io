---
---
<style>
  .pub-custom-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 1.6rem;
  }

  .pub-custom-media {
    flex: 0 0 44%;
    max-width: 44%;
    min-width: 0;
  }

  .pub-custom-info {
    flex: 1 1 0;
    min-width: 0;
  }

  .pub-venue-bar {
    width: 100%;
    box-sizing: border-box;
    display: block;
    margin: 0 0 0.5rem 0;
    padding: 0.55em 0.75em;
    border-radius: 0.3rem;
    color: #fff !important;
    text-align: center;
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .pub-venue-bar a,
  .pub-venue-bar span {
    display: block;
    width: 100%;
    color: #fff !important;
    text-decoration: none !important;
  }

  .pub-preview-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--global-bg-color);
    border-radius: 0.3rem;
  }

  .pub-preview-frame video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .pub-preview-frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: center;
  }

  @media (max-width: 767.98px) {
    .pub-custom-row {
      display: block;
    }

    .pub-custom-media,
    .pub-custom-info {
      width: 100%;
      max-width: 100%;
    }

    .pub-custom-media {
      margin-bottom: 1rem;
    }
  }
</style>

<div class="pub-custom-row">
  {% if site.enable_publication_thumbnails %}
    <div class="pub-custom-media">
      {% if entry.abbr %}
        {% assign venue = site.data.venues[entry.abbr] %}
        {% if entry.type == 'article' %}
          {% assign badge_color = '#2E7D32' %}
        {% else %}
          {% assign badge_color = '#1565C0' %}
        {% endif %}

        <div class="pub-venue-bar" style="background-color: {{ badge_color }} !important;">
          {% if venue and venue.url %}
            <a href="{{ venue.url }}">{{ entry.abbr }}</a>
          {% else %}
            <span>{{ entry.abbr }}</span>
          {% endif %}
        </div>
      {% endif %}

      {% if entry.preview %}
        {% assign preview_ext = entry.preview | split: '.' | last | downcase %}
        {% assign preview_path = entry.preview %}
        {% unless entry.preview contains '://' %}
          {% assign preview_path = entry.preview | prepend: '/assets/img/publication_preview/' | relative_url %}
        {% endunless %}

        <div class="pub-preview-frame z-depth-1">
          {% if preview_ext == 'mp4' or preview_ext == 'webm' or preview_ext == 'ogg' or preview_ext == 'mov' %}
            <video autoplay muted loop playsinline preload="metadata">
              <source src="{{ preview_path }}">
            </video>
          {% else %}
            <img src="{{ preview_path }}" alt="{{ entry.title | escape }}" loading="lazy">
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div id="{{ entry.key }}" class="pub-custom-info">
<div class="title">{{ entry.title }}</div>

    <div class="author">
      {% assign author_count = entry.author_array | size %}
      {% assign penultimate_author = author_count | minus: 1 %}

      {% for author in entry.author_array %}
        {% assign clean_last = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' %}
        {% assign marked_last = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' %}

        {% assign is_self = false %}
        {% if clean_last == 'Oh' and author.first == 'Wooseok' %}
          {% assign is_self = true %}
        {% endif %}

        {% if is_self %}
          <strong style="font-weight: 700;">{{ author.first }} {{ marked_last }}</strong>
        {% else %}
          {{ author.first }} {{ marked_last }}
        {% endif %}

        {% unless forloop.last %}
          {% if forloop.index == penultimate_author %}
            and
          {% else %}
            ,
          {% endif %}
        {% endunless %}
      {% endfor %}
    </div>

    {% if entry.annotation %}
      <div class="periodical">
        <strong style="font-weight: 700;">{{ entry.annotation }}</strong>
      </div>
    {% endif %}

    {% assign proceedings = 'inproceedings,incollection' | split: ',' %}
    <div class="periodical">
      {% if entry.type == 'article' %}
        <em>{{ entry.journal }}</em>
      {% elsif proceedings contains entry.type %}
        <em>In {{ entry.booktitle }}</em>
      {% endif %}
      {% if entry.month %}, {{ entry.month | capitalize }}{% endif %}
      {% if entry.year %}, {{ entry.year }}{% endif %}
    </div>

    {% if entry.note %}
      <div class="periodical">{{ entry.note }}</div>
    {% endif %}

    {% if entry.keywords and page.permalink == '/publications/' %}
      {% assign keyword_list = entry.keywords | split: ',' %}
      <div style="margin-top: 0.35rem; margin-bottom: 0.15rem;">
        {% for keyword in keyword_list %}
          <span
            class="badge rounded-pill"
            style="
              margin-right: 0.25rem;
              margin-bottom: 0.25rem;
              padding: 0.35em 0.65em;
              background-color: var(--global-code-bg-color);
              color: var(--global-text-color);
              border: 1px solid var(--global-divider-color);
              font-weight: 500;
            "
          >{{ keyword | strip }}</span>
        {% endfor %}
      </div>
    {% endif %}

    <div class="links">
      {% if entry.doi %}
        <a href="https://doi.org/{{ entry.doi }}" class="btn btn-sm z-depth-0" role="button">Paper</a>
      {% endif %}

      {% if entry.arxiv %}
        <a href="https://arxiv.org/abs/{{ entry.arxiv }}" class="btn btn-sm z-depth-0" role="button">arXiv</a>
      {% endif %}

      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}
          <a href="{{ entry.pdf }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
        {% else %}
          <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
        {% endif %}
      {% endif %}

      {% if entry.code %}
        <a href="{{ entry.code }}" class="btn btn-sm z-depth-0" role="button">Code</a>
      {% endif %}

      {% if entry.dataset %}
        <a href="{{ entry.dataset }}" class="btn btn-sm z-depth-0" role="button">Dataset</a>
      {% endif %}

      {% if entry.website %}
        <a href="{{ entry.website }}" class="btn btn-sm z-depth-0" role="button">Website</a>
      {% endif %}

      {% if entry.video %}
        <a href="{{ entry.video }}" class="btn btn-sm z-depth-0" role="button">Video</a>
      {% endif %}

      {% if entry.poster %}
        {% if entry.poster contains '://' %}
          <a href="{{ entry.poster }}" class="btn btn-sm z-depth-0" role="button">Poster</a>
        {% else %}
          <a href="{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Poster</a>
        {% endif %}
      {% endif %}

      {% if entry.slides %}
        {% if entry.slides contains '://' %}
          <a href="{{ entry.slides }}" class="btn btn-sm z-depth-0" role="button">Slides</a>
        {% else %}
          <a href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Slides</a>
        {% endif %}
      {% endif %}

      {% if entry.bibtex_show %}
        <a class="bibtex btn btn-sm z-depth-0" role="button">Bib</a>
      {% endif %}
    </div>

    {% if entry.bibtex_show %}
      <div class="bibtex hidden">
        {% highlight bibtex %}
        {{- entry.bibtex | hideCustomBibtex -}}
        {% endhighlight %}
      </div>
    {% endif %}
  </div>
</div>
