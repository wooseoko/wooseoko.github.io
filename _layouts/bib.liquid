---
---

<style>
  .pub-custom-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 1.6rem;
  }

  .pub-custom-media {
    flex: 0 0 44%;
    max-width: 44%;
    min-width: 0;
  }

  .pub-custom-info {
    flex: 1 1 0;
    min-width: 0;
  }

  /* Thumbnail */
  .pub-preview-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--global-bg-color);
    border-radius: 0.3rem;
  }

  .pub-preview-frame video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .pub-preview-frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: center;
  }

  /* Venue + keyword pills */
  .pub-meta-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    margin-bottom: 0.55rem;
  }

  .pub-meta-tag {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.32rem 0.68rem;
    font-size: 0.82rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* Conference venue: IROS, ICCAS */
  .pub-venue-conference {
    background-color: #1565c0;
    color: #ffffff !important;
    border: 1px solid #1565c0;
    font-weight: 700;
  }

  /* Journal venue: RA-L, PRL */
  .pub-venue-journal {
    background-color: #2e7d32;
    color: #ffffff !important;
    border: 1px solid #2e7d32;
    font-weight: 700;
  }

  .pub-venue-conference a,
  .pub-venue-journal a {
    color: #ffffff !important;
    text-decoration: none !important;
  }

  /* Ordinary research keywords */
  .pub-keyword {
    background-color: var(--global-code-bg-color);
    color: var(--global-text-color);
    border: 1px solid var(--global-divider-color);
    font-weight: 500;
  }

  @media (max-width: 767.98px) {
    .pub-custom-row {
      display: block;
    }

    .pub-custom-media,
    .pub-custom-info {
      width: 100%;
      max-width: 100%;
    }

    .pub-custom-media {
      margin-bottom: 1rem;
    }
  }
</style>


<div class="pub-custom-row">

  {% if site.enable_publication_thumbnails %}
    <div class="pub-custom-media">

      {% if entry.preview %}
        {% assign preview_ext = entry.preview | split: '.' | last | downcase %}
        {% assign preview_path = entry.preview %}

        {% unless entry.preview contains '://' %}
          {% assign preview_path = entry.preview
            | prepend: '/assets/img/publication_preview/'
            | relative_url
          %}
        {% endunless %}

        <div class="pub-preview-frame z-depth-1">

          {% if preview_ext == 'mp4'
            or preview_ext == 'webm'
            or preview_ext == 'ogg'
            or preview_ext == 'mov'
          %}

            <video autoplay muted loop playsinline preload="metadata">
              <source src="{{ preview_path }}">
            </video>

          {% else %}

            <img
              src="{{ preview_path }}"
              alt="{{ entry.title | escape }}"
              loading="lazy"
            >

          {% endif %}

        </div>
      {% endif %}

    </div>
  {% endif %}


  <div id="{{ entry.key }}" class="pub-custom-info">

    <!-- Title -->
    <div class="title" style="font-weight: 700;">
      {{ entry.title }}
    </div>

    <!-- Authors -->
    <div class="author">

      {% assign author_count = entry.author_array | size %}
      {% assign penultimate_author = author_count | minus: 1 %}

      {% for author in entry.author_array %}

        {% assign clean_last = author.last
          | regex_replace: '[*∗†‡§¶‖&^]', ''
        %}

        {% assign marked_last = author.last
          | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>'
        %}

        {% assign is_self = false %}

        {% if clean_last == 'Oh' and author.first == 'Wooseok' %}
          {% assign is_self = true %}
        {% endif %}


        {% if is_self %}

          <strong style="font-weight: 700;">
            {{ author.first }} {{ marked_last }}
          </strong>

        {% else %}

          {{ author.first }} {{ marked_last }}

        {% endif %}


        {% unless forloop.last %}

          {% if forloop.index == penultimate_author %}
            and
          {% else %}
            ,
          {% endif %}

        {% endunless %}

      {% endfor %}

    </div>


    <!-- Equal contribution / annotation -->
    {% if entry.annotation %}
      <div class="periodical">
        <strong style="font-weight: 700;">
          {{ entry.annotation }}
        </strong>
      </div>
    {% endif %}


    <!-- Venue full name + date -->
    {% assign proceedings = 'inproceedings,incollection' | split: ',' %}

    <div class="periodical">

      {% if entry.type == 'article' %}

        <em>{{ entry.journal }}</em>

      {% elsif proceedings contains entry.type %}

        <em>In {{ entry.booktitle }}</em>

      {% endif %}

      {% if entry.month %}
        , {{ entry.month | capitalize }}
      {% endif %}

      {% if entry.year %}
        , {{ entry.year }}
      {% endif %}

    </div>


    <!-- Note -->
    {% if entry.note %}
      <div class="periodical">
        {{ entry.note }}
      </div>
    {% endif %}


    <!-- Venue + Keywords -->
    <!--
      No page.permalink condition here:
      this makes the tags appear both on
      Publications and Home Selected Publications.
    -->
    {% if entry.abbr or entry.keywords %}

      <div class="pub-meta-tags">

        <!-- Venue first -->
        {% if entry.abbr %}

          {% assign venue = site.data.venues[entry.abbr] %}

          {% if entry.type == 'article' %}
            {% assign venue_class = 'pub-venue-journal' %}
          {% else %}
            {% assign venue_class = 'pub-venue-conference' %}
          {% endif %}


          {% if venue and venue.url %}

            <span class="pub-meta-tag {{ venue_class }}">
              <a href="{{ venue.url }}">
                {{ entry.abbr }}
              </a>
            </span>

          {% else %}

            <span class="pub-meta-tag {{ venue_class }}">
              {{ entry.abbr }}
            </span>

          {% endif %}

        {% endif %}


        <!-- Keywords -->
        {% if entry.keywords %}

          {% assign keyword_list = entry.keywords | split: ',' %}

          {% for keyword in keyword_list %}

            <span class="pub-meta-tag pub-keyword">
              {{ keyword | strip }}
            </span>

          {% endfor %}

        {% endif %}

      </div>

    {% endif %}


    <!-- Links -->
    <div class="links">

      {% if entry.doi %}
        <a
          href="https://doi.org/{{ entry.doi }}"
          class="btn btn-sm z-depth-0"
          role="button"
        >
          Paper
        </a>
      {% endif %}


      {% if entry.arxiv %}
        <a
          href="https://arxiv.org/abs/{{ entry.arxiv }}"
          class="btn btn-sm z-depth-0"
          role="button"
        >
          arXiv
        </a>
      {% endif %}


      <!-- Project Page -->
      {% if entry.project %}
        <a
          href="{{ entry.project }}"
          class="btn btn-sm z-depth-0"
          role="button"
        >
          Project
        </a>
      {% endif %}


      {% if entry.pdf %}

        {% if entry.pdf contains '://' %}

          <a
            href="{{ entry.pdf }}"
            class="btn btn-sm z-depth-0"
            role="button"
          >
            PDF
          </a>

        {% else %}

          <a
            href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}"
            class="btn btn-sm z-depth-0"
            role="button"
          >
            PDF
          </a>

        {% endif %}

      {% endif %}


      {% if entry.code %}
        <a
          href="{{ entry.code }}"
          class="btn btn-sm z-depth-0"
          role="button"
        >
          Code
        </a>
      {% endif %}


      {% if entry.dataset %}
        <a
          href="{{ entry.dataset }}"
          class="btn btn-sm z-depth-0"
          role="button"
        >
          Dataset
        </a>
      {% endif %}


      {% if entry.website %}
        <a
          href="{{ entry.website }}"
          class="btn btn-sm z-depth-0"
          role="button"
        >
          Website
        </a>
      {% endif %}


      {% if entry.video %}
        <a
          href="{{ entry.video }}"
          class="btn btn-sm z-depth-0"
          role="button"
        >
          Video
        </a>
      {% endif %}


      {% if entry.poster %}

        {% if entry.poster contains '://' %}

          <a
            href="{{ entry.poster }}"
            class="btn btn-sm z-depth-0"
            role="button"
          >
            Poster
          </a>

        {% else %}

          <a
            href="{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}"
            class="btn btn-sm z-depth-0"
            role="button"
          >
            Poster
          </a>

        {% endif %}

      {% endif %}


      {% if entry.slides %}

        {% if entry.slides contains '://' %}

          <a
            href="{{ entry.slides }}"
            class="btn btn-sm z-depth-0"
            role="button"
          >
            Slides
          </a>

        {% else %}

          <a
            href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}"
            class="btn btn-sm z-depth-0"
            role="button"
          >
            Slides
          </a>

        {% endif %}

      {% endif %}


      {% if entry.bibtex_show %}
        <a
          class="bibtex btn btn-sm z-depth-0"
          role="button"
        >
          Bib
        </a>
      {% endif %}

    </div>


    <!-- BibTeX -->
    {% if entry.bibtex_show %}

      <div class="bibtex hidden">

        {% highlight bibtex %}
        {{- entry.bibtex | hideCustomBibtex -}}
        {% endhighlight %}

      </div>

    {% endif %}

  </div>

</div>
