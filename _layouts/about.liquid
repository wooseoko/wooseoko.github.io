---
layout: default
---

<style>
  .about-contact-profile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    margin: 1.8rem 0 2.4rem;
  }

  .about-contact-profile .about-contact {
    flex: 1 1 auto;
    min-width: 0;
    text-align: left;
  }

  .about-contact-profile .about-contact .social {
    text-align: left;
    margin: 0;
  }

  .about-contact-profile .about-contact .contact-icons {
    text-align: left;
    font-size: 1.55rem;
    line-height: 1.5;
  }

  .about-contact-profile .about-contact .contact-note {
    text-align: left;
    margin-top: 0.5rem;
  }

  .about-contact-profile .about-profile-photo {
    flex: 0 0 210px;
    width: 210px;
  }

  .about-contact-profile .about-profile-photo img {
    width: 210px;
    height: 210px;
    display: block;
    object-fit: cover;
    object-position: center;
    border-radius: 50% !important;
  }

  .about-contact-profile .more-info {
    margin-top: 0.75rem;
    text-align: left;
  }

  @media (max-width: 767.98px) {
    .about-contact-profile {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .about-contact-profile .about-profile-photo {
      flex-basis: auto;
      width: 170px;
    }

    .about-contact-profile .about-profile-photo img {
      width: 170px;
      height: 170px;
    }

    .about-contact-profile .about-contact {
      width: 100%;
    }
  }
</style>

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span>
        {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    <!-- About text first -->
    <div class="clearfix">{{ content }}</div>

    <!-- Contact/social links on the left, circular profile photo on the right -->
    {% if page.social or page.profile %}
      <div class="about-contact-profile">
        <div class="about-contact">
          {% if page.social %}
            <div class="social">
              <div class="contact-icons">{% social_links %}</div>
              {% if site.contact_note %}
                <div class="contact-note">{{ site.contact_note }}</div>
              {% endif %}
            </div>
          {% endif %}

          {% if page.profile and page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>

        {% if page.profile and page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          <div class="about-profile-photo">
            {% include figure.liquid
              loading="eager"
              path=profile_image_path
              class="img-fluid z-depth-1 rounded-circle"
              alt=page.profile.image
              cache_bust=true
            %}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <!-- Selected papers immediately below the contact/profile row -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>
